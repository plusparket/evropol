---
// Оформление сайта раздела (vinyl.localhost …). Шрифт, шапка, подвал и кнопки — как на главном сайте,
// основной цвет — свой у каждого раздела (админка → «Разделы» → «Сайт раздела»).
import { ClientRouter } from 'astro:transitions';
import '../styles/site.css';
import '../styles/section-site.css';
import SiteHeader from '../components/section-site/SiteHeader.astro';
import SiteFooter from '../components/section-site/SiteFooter.astro';
import { getSettings, siteSettings } from '../server/settings.ts';
import { DEFAULT_SITE_COLOR, getSections, siteUrl, type Section } from '../server/sections.ts';

interface Props {
  site: Section;
  title: string;
  description?: string;
  noindex?: boolean;
  /** Основной адрес страницы (canonical) на сайте раздела: / или /cairo-doska */
  canonicalPath?: string;
  /** Картинка для превью ссылки (путь от корня сайта) */
  image?: string;
  jsonLd?: object | object[];
}
const { site, title, description, noindex = false, canonicalPath, image, jsonLd } = Astro.props;

const [allSettings, sections] = await Promise.all([getSettings(), getSections({ publishedOnly: true })]);
const settings = siteSettings(allSettings, site);
const base = siteUrl(site);
const canonical = base + (canonicalPath ?? (Astro.url.pathname.replace(/^\/section-site/, '') || '/'));
const ogImage = base + (image || '/img/og-europroject.jpg');
const ldBlocks = (Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []).map((o) => JSON.stringify(o).replace(/</g, '\\u003c'));
const color = /^#[0-9a-f]{6}$/i.test(site.siteColor) ? site.siteColor : DEFAULT_SITE_COLOR;
const waHref = 'https://wa.me/' + settings.panel_whatsapp.replace(/\D/g, '');
const countersOn = settings.counters_enabled === '1';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="build" content={__BUILD_ID__} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico?v=4" sizes="48x48" />
    <link rel="icon" href="/favicon.svg?v=4" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=4" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={`${site.name} · ${settings.site_name}`} />
    <meta name="theme-color" content={color} />
    {ldBlocks.map((json) => <script type="application/ld+json" set:html={json} />)}
    <ClientRouter fallback="swap" />
    {countersOn && settings.head_code && <Fragment set:html={settings.head_code} />}
  </head>
  <body class="ss" style={`--site: ${color}`}>
    <div class="wrapper" id="overlay"></div>

    <SiteHeader site={site} sections={sections} settings={settings} />

    <main class="container" id="container" transition:name="page-content">
      <slot />
    </main>

    <SiteFooter site={site} sections={sections} settings={settings} />

    {
      settings.panel_whatsapp && (
        <a class="fab-wa" href={waHref} target="_blank" rel="noopener" aria-label={`WhatsApp ${settings.panel_whatsapp}`}>
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5.1 5.2-1.4A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3.1.8.8-3-.2-.3a8.2 8.2 0 1 1 7 3.9Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.7 11.7 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.2-.2-.5-.3Z"/></svg>
        </a>
      )
    }
    <button type="button" class="to-top" id="to-top" aria-label="Наверх">↑</button>

    {countersOn && settings.body_code && <div transition:persist="site-counters" set:html={settings.body_code} />}

    <script>
      import '../scripts/site.ts';
      import '../scripts/ui.ts';
      import '../scripts/section-site.ts';
    </script>
  </body>
</html>
