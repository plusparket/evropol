---
import '../styles/admin.css';
import { flash } from '../server/admin.ts';

interface Props {
  title: string;
  /** Раздел меню для подсветки */
  section?: string;
}
const { title, section = '' } = Astro.props;
const user = Astro.locals.user;
const { ok, err } = flash(Astro.url);

const nav: { sec: string; items: { key: string; href: string; label: string }[] }[] = [
  { sec: '', items: [{ key: 'dashboard', href: '/admin', label: 'Обзор' }] },
  {
    sec: 'Сайт',
    items: [
      { key: 'home', href: '/admin/home', label: 'Главная страница' },
      { key: 'sections', href: '/admin/sections', label: 'Разделы' },
      { key: 'brands', href: '/admin/brands', label: 'Бренды' },
      { key: 'pages', href: '/admin/pages', label: 'Страницы' },
      { key: 'news', href: '/admin/news', label: 'Новости' },
      { key: 'menus', href: '/admin/menus', label: 'Меню' },
    ],
  },
  {
    sec: 'Система',
    items: [
      { key: 'settings', href: '/admin/settings', label: 'Настройки сайта' },
      { key: 'redirects', href: '/admin/redirects', label: 'Переадресации' },
      { key: 'users', href: '/admin/users', label: 'Пользователи' },
    ],
  },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — панель управления</title>
    <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
  </head>
  <body>
    <div class="adm">
      <aside class="adm-side" id="adm-side">
        <a class="adm-brand" href="/admin"><img class="adm-logo-text" src="/img/europroject-logo-white.svg" alt="Европроект" /></a>
        <nav class="adm-nav">
          {
            nav.map((group) => (
              <Fragment>
                {group.sec && <div class="sec">{group.sec}</div>}
                {group.items.map((i) => (
                  <a href={i.href} class:list={{ active: i.key === section }}>
                    {i.label}
                  </a>
                ))}
              </Fragment>
            ))
          }
        </nav>
      </aside>

      <div class="adm-main">
        <div class="adm-top">
          <div class="inline">
            <button type="button" class="btn secondary sm adm-burger" id="adm-burger">☰ Меню</button>
            <a href="/" target="_blank" rel="noopener">Открыть сайт ↗</a>
          </div>
          <div class="inline">
            {user && <span class="adm-user">{user.name || user.login}</span>}
            <a href="/admin/profile" class="btn secondary sm">Мой пароль</a>
            <form method="post" action="/admin/logout">
              <button class="btn secondary sm" type="submit">Выйти</button>
            </form>
          </div>
        </div>

        <main class="adm-content">
          {ok && <div class="flash ok">{ok}</div>}
          {err && <div class="flash err">{err}</div>}
          <slot />
        </main>
      </div>
    </div>

    <script>
      import '../scripts/admin.ts';
    </script>
  </body>
</html>
