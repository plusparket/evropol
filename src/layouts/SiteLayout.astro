---
import { ClientRouter } from 'astro:transitions';
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSettings } from '../server/settings.ts';
import { getMenus } from '../server/content.ts';
import { getSections } from '../server/sections.ts';
import { siteBase } from '../server/seo.ts';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Основной адрес страницы (canonical), например /vinyl или /news/new-carpet-collection. По умолчанию — текущий путь */
  canonicalPath?: string;
  /** Картинка для превью ссылки в мессенджерах и соцсетях (путь от корня сайта) */
  image?: string;
  ogType?: 'website' | 'article';
  /** Разметка schema.org (JSON-LD) */
  jsonLd?: object | object[];
}
const { title, description, noindex = false, canonicalPath, image, ogType = 'website', jsonLd } = Astro.props;

const [settings, menus, sections] = await Promise.all([getSettings(), getMenus(), getSections({ publishedOnly: true })]);
const countersOn = settings.counters_enabled === '1';
const siteUrl = siteBase(Astro.url.origin);
const canonical = siteUrl + (canonicalPath ?? Astro.url.pathname);
const ogImage = siteUrl + (image || '/img/og-europroject.jpg');
const ldBlocks = (Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []).map((o) => JSON.stringify(o).replace(/</g, '\\u003c'));
const ga4 = countersOn && /^G-[A-Z0-9]+$/i.test(settings.ga4_id) ? settings.ga4_id : '';
const copyright = settings.copyright.replaceAll('{year}', String(new Date().getFullYear()));
const waHref = 'https://wa.me/' + settings.panel_whatsapp.replace(/\D/g, '');
const secondName = settings.name_second || 'Второй адрес';
const maps = [
  { src: settings.map_embed_url, title: `Офис: ${settings.address}` },
  { src: settings.map_embed_url_second, title: `${secondName}: ${settings.address_second}` },
].filter((m) => m.src.startsWith('https://'));
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="build" content={__BUILD_ID__} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico?v=3" sizes="48x48" />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={settings.site_name} />
    <meta name="twitter:card" content="summary_large_image" />
    {settings.google_site_verification && <meta name="google-site-verification" content={settings.google_site_verification} />}
    {settings.yandex_verification && <meta name="yandex-verification" content={settings.yandex_verification} />}
    <meta name="theme-color" content="#ffffff" />
    {ldBlocks.map((json) => <script type="application/ld+json" set:html={json} />)}
    <ClientRouter fallback="swap" />
    {
      ga4 && (
        <Fragment>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`} />
          <script is:inline define:vars={{ ga4 }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', ga4);
          </script>
        </Fragment>
      )
    }
    {countersOn && settings.head_code && <Fragment set:html={settings.head_code} />}
  </head>
  <body>
    <div class="wrapper" id="overlay"></div>

    <Header sections={sections} settings={settings} menus={menus} />

    <div class="loading" id="loading"></div>

    <main class="container" id="container" transition:name="page-content">
      <slot />
    </main>

    <Footer settings={settings} menus={menus} sections={sections} maps={maps} copyright={copyright} />

    {
      settings.panel_whatsapp && (
        <a class="fab-wa" href={waHref} target="_blank" rel="noopener" aria-label={`WhatsApp ${settings.panel_whatsapp}`}>
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5.1 5.2-1.4A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3.1.8.8-3-.2-.3a8.2 8.2 0 1 1 7 3.9Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.7 11.7 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.2-.2-.5-.3Z"/></svg>
        </a>
      )
    }
    <button type="button" class="to-top" id="to-top" aria-label="Наверх">↑</button>

    {countersOn && settings.body_code && <div transition:persist="site-counters" set:html={settings.body_code} />}

    <script>
      import '../scripts/site.ts';
      import '../scripts/ui.ts';
    </script>
  </body>
</html>
