---
// Редактор главной страницы (вид по образцу berryalloc.com, 10.11.2026): главный экран, приветствие, плитки разделов
// с краткими описаниями, блок консультации. Прежние блоки (о компании, бренды, новости, контакты) на главной не выводятся,
// их значения сохраняются как были.
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getHome, homeImages, saveHome, type HomeContent } from '../../server/home.ts';
import { getSections } from '../../server/sections.ts';
import { formFiles, removeUploads, saveImage, uploadUrl } from '../../server/uploads.ts';
import { withFlash } from '../../server/admin.ts';
import { str, strs } from '../../server/util.ts';

let error = '';
const current = await getHome();
const sections = await getSections();

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const newFiles: string[] = [];
  try {
    // Фото главного экрана: порядок, удаление, добавление
    const heroPaths = strs(data, 'hero_img');
    const heroOrder = strs(data, 'hero_order').map(Number);
    const heroDel = new Set(strs(data, 'hero_del'));
    const hero = heroPaths
      .map((p, i) => ({ p, o: heroOrder[i] || 0 }))
      .filter((x) => !heroDel.has(x.p))
      .sort((a, b) => a.o - b.o)
      .map((x) => x.p);
    for (const f of formFiles(data, 'hero_new')) {
      const [p] = await saveImage(Buffer.from(await f.arrayBuffer()), 'home');
      newFiles.push(p);
      hero.push(p);
    }

    const next: HomeContent = {
      hero: {
        title: str(data, 'hero_title'), text: str(data, 'hero_text'), button: str(data, 'hero_button'), link: str(data, 'hero_link'), images: hero,
        sectionSlides: data.get('hero_sections') === '1',
      },
      about: current.about,
      sections: current.sections,
      brands: current.brands,
      news: current.news,
      contact: current.contact,
      welcome: { title: str(data, 'welcome_title'), text: str(data, 'welcome_text') },
      catalog: {
        title: str(data, 'catalog_title'),
        button: str(data, 'catalog_button'),
        texts: Object.fromEntries(sections.map((s) => [s.slug, str(data, `tile_${s.slug}`)])),
        hidden: sections.filter((s) => data.get(`tile_hide_${s.slug}`) === '1').map((s) => s.slug),
      },
      consult: { title: str(data, 'consult_title'), text: str(data, 'consult_text'), button: str(data, 'consult_button'), link: str(data, 'consult_link') },
    };
    await saveHome(next);
    // Удаляем файлы, на которые больше нет ссылок
    const keep = new Set(homeImages(next));
    await removeUploads(...homeImages(current).filter((p) => !keep.has(p)));
    return Astro.redirect(withFlash('/admin/home', 'ok', 'saved'));
  } catch (err) {
    await removeUploads(...newFiles);
    error = (err as Error).message;
  }
}

const h = current;
---

<AdminLayout title="Главная страница" section="home">
  <div class="toolbar">
    <h1>Главная страница</h1>
    <div class="actions"><a class="btn secondary" href="/" target="_blank" rel="noopener">Открыть сайт ↗</a></div>
  </div>
  {error && <div class="flash err">{error}</div>}
  <p class="muted small">
    Перенос строки в заголовке главного экрана — клавиша Enter. Пустой заголовок у блока — блок не показывается.
    Плитки разделов берутся из «Разделов»: название, ссылка, порядок.
  </p>

  <form method="post" enctype="multipart/form-data">
    <div class="card">
      <h2>1. Главный экран</h2>
      <label class="check"><input type="checkbox" name="hero_sections" value="1" checked={h.hero.sectionSlides} />
        Показывать фото разделов (линолеум, ковролин, ковровая плитка, кварц-винил, ламинат, паркет) с названием раздела и кнопкой</label>
      <p class="hint">Снимите галочку, чтобы вернуть загруженные ниже фото и заголовок главного экрана.</p>
      <div class="form-grid">
        <div class="field full">
          <label for="hero_title">Заголовок</label>
          <textarea id="hero_title" name="hero_title" rows="2">{h.hero.title}</textarea>
        </div>
        <div class="field full">
          <label for="hero_text">Текст под заголовком</label>
          <textarea id="hero_text" name="hero_text" rows="2">{h.hero.text}</textarea>
        </div>
        <div class="field">
          <label for="hero_button">Текст кнопки</label>
          <input type="text" id="hero_button" name="hero_button" value={h.hero.button} />
        </div>
        <div class="field">
          <label for="hero_link">Ссылка кнопки</label>
          <input type="text" id="hero_link" name="hero_link" value={h.hero.link} />
          <div class="hint"><code>#razdely</code> — прокрутка к разделам на главной</div>
        </div>
      </div>
      <div class="gallery" style="margin-top:14px">
        {
          h.hero.images.map((img, i) => (
            <div class="img-card">
              <img src={uploadUrl(img)} alt="" />
              <input type="hidden" name="hero_img" value={img} />
              <label class="small">Порядок <input type="number" name="hero_order" value={(i + 1) * 10} /></label>
              <br />
              <label class="check small"><input type="checkbox" name="hero_del" value={img} /> удалить</label>
            </div>
          ))
        }
      </div>
      <div class="field" style="margin-top:12px">
        <label for="hero_new">Добавить фото</label>
        <input type="file" id="hero_new" name="hero_new" accept="image/*" multiple />
        <div class="hint">Горизонтальные фото от 2000 px по ширине, несколько фото сменяют друг друга. Без фото — тёмный фон.</div>
      </div>
    </div>

    <div class="card">
      <h2>2. Приветствие</h2>
      <div class="form-grid">
        <div class="field full">
          <label for="welcome_title">Заголовок</label>
          <input type="text" id="welcome_title" name="welcome_title" value={h.welcome.title} />
        </div>
        <div class="field full">
          <label for="welcome_text">Текст</label>
          <textarea id="welcome_text" name="welcome_text" rows="4">{h.welcome.text}</textarea>
        </div>
      </div>
    </div>

    <div class="card">
      <h2>3. Разделы (плитки с фото)</h2>
      <div class="form-grid">
        <div class="field">
          <label for="catalog_title">Заголовок</label>
          <input type="text" id="catalog_title" name="catalog_title" value={h.catalog.title} />
        </div>
        <div class="field">
          <label for="catalog_button">Текст кнопки на плитке</label>
          <input type="text" id="catalog_button" name="catalog_button" value={h.catalog.button} />
        </div>
        {
          sections.map((s) => (
            <div class="field full">
              <label for={`tile_${s.slug}`}>{s.name}{!s.isPublished && ' (скрыт)'}: краткое описание</label>
              <textarea id={`tile_${s.slug}`} name={`tile_${s.slug}`} rows="2">{h.catalog.texts[s.slug] ?? ''}</textarea>
              <label class="check small"><input type="checkbox" name={`tile_hide_${s.slug}`} value="1" checked={h.catalog.hidden.includes(s.slug)} /> не показывать плитку на главной</label>
            </div>
          ))
        }
      </div>
      <p class="hint">Пустое описание — берётся краткое описание из <a href="/admin/sections">Разделов</a>. Порядок и видимость плиток — там же.</p>
    </div>

    <div class="card">
      <h2>4. Консультация</h2>
      <div class="form-grid">
        <div class="field full">
          <label for="consult_title">Заголовок</label>
          <input type="text" id="consult_title" name="consult_title" value={h.consult.title} />
        </div>
        <div class="field full">
          <label for="consult_text">Текст (Enter — новая строка)</label>
          <textarea id="consult_text" name="consult_text" rows="3">{h.consult.text}</textarea>
        </div>
        <div class="field">
          <label for="consult_button">Текст кнопки</label>
          <input type="text" id="consult_button" name="consult_button" value={h.consult.button} />
        </div>
        <div class="field">
          <label for="consult_link">Ссылка кнопки</label>
          <input type="text" id="consult_link" name="consult_link" value={h.consult.link} />
          <div class="hint">Пусто — WhatsApp из «Настроек сайта»</div>
        </div>
      </div>
    </div>

    <div class="form-actions sticky-actions"><button class="btn" type="submit">Сохранить главную</button></div>
  </form>
</AdminLayout>
