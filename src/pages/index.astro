---
import SiteLayout from '../layouts/SiteLayout.astro';
import Home from '../components/Home.astro';
import { getSettings } from '../server/settings.ts';
import { getHome } from '../server/home.ts';
import { getSections } from '../server/sections.ts';
import { organizationJsonLd, siteBase } from '../server/seo.ts';

const [settings, home, sections] = await Promise.all([getSettings(), getHome(), getSections({ publishedOnly: true })]);
// Разметка для Google: организация и офис (адрес, телефон, часы, координаты)
const base = siteBase(Astro.url.origin);
const orgLd = organizationJsonLd(settings, base, `${base}/img/og-evropol.jpg`);
const title = settings.seo_title || settings.site_name;
const description = settings.seo_description || undefined;
---

<SiteLayout title={title} description={description} canonicalPath="/" jsonLd={orgLd}>
  <Home home={home} sections={sections} settings={settings} />
</SiteLayout>
