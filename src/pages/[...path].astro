---
// Страницы разделов (/vinyl, /carpet-tiles …) и текстовые страницы (/about, /contact …).
import SiteLayout from '../layouts/SiteLayout.astro';
import NotFound from '../components/NotFound.astro';
import SectionView from '../components/SectionView.astro';
import PageView from '../components/PageView.astro';
import { getPageBySlug } from '../server/content.ts';
import { getActiveBrands, getSectionBySlug } from '../server/sections.ts';
import { fillPlaceholders, getSettings } from '../server/settings.ts';
import { plainText } from '../server/util.ts';
import { breadcrumbJsonLd, organizationJsonLd, sectionDescription, sectionTitle, siteBase, withSiteName } from '../server/seo.ts';
import { findRedirect } from '../server/redirects.ts';

const raw = Astro.params.path ?? '';
const path = raw.replace(/\/+$/, '');
const single = !path.includes('/');
const section = single && path ? await getSectionBySlug(path) : undefined;
const page = single && path && !section ? await getPageBySlug(path) : undefined;

// Один адрес у страницы: /vinyl/ → /vinyl (постоянная переадресация, как любит Google)
const canonicalPath = section ? `/${section.slug}` : page ? `/${page.slug}` : undefined;
if (canonicalPath && Astro.url.pathname !== canonicalPath) return Astro.redirect(canonicalPath + Astro.url.search, 301);
// Раздел без своего сайта, но со ссылкой (например, «Паркет» → domparketa.kg/parquet): страница раздела ведёт туда
if (section && !section.siteHost && section.link) return Astro.redirect(section.link, 302);
// Адреса старого сайта (/o-kompanii.html, /kontakty …) — по таблице переадресаций (админка → «Переадресации»)
if (!canonicalPath) {
  const target = await findRedirect(Astro.url.pathname);
  if (target) return Astro.redirect(target, 301);
}

if (!section && !page) Astro.response.status = 404;
const settings = await getSettings();
const brands = section ? await getActiveBrands(section.id) : [];
const pageContent = page ? fillPlaceholders(page.content, settings) : '';
const base = siteBase(Astro.url.origin);
const heading = section ? section.heading || section.name : '';
const crumbsLd = section ? breadcrumbJsonLd(base, [{ name: heading, url: `/${section.slug}` }]) : undefined;
// На странице «Контакты» — разметка компании (адрес, телефон, часы работы)
const pageLd = page?.slug === 'contact' ? organizationJsonLd(settings, base, `${base}/img/og-europroject.jpg`) : undefined;
---

{
  section ? (
    <SiteLayout
      title={section.seoTitle || sectionTitle(heading, settings)}
      description={section.seoDescription || plainText(section.description) || sectionDescription(heading, settings)}
      canonicalPath={`/${section.slug}`}
      image={section.image ? `/uploads/${section.image}` : undefined}
      jsonLd={crumbsLd}
    >
      <SectionView section={section} brands={brands} settings={settings} />
    </SiteLayout>
  ) : page ? (
    <SiteLayout
      title={page.seoTitle || withSiteName(page.title, settings)}
      description={page.seoDescription || plainText(pageContent) || undefined}
      canonicalPath={`/${page.slug}`}
      jsonLd={pageLd}
    >
      <PageView title={page.title} html={pageContent} />
    </SiteLayout>
  ) : (
    <SiteLayout title="Страница не найдена" noindex>
      <NotFound />
    </SiteLayout>
  )
}
