---
// Плитки групп или категорий: фото товара, название, пара слов и число товаров. Фото — первого товара
// с фото (товары в наличии идут первыми).
import { productThumb, productsOf, type CategoryNode, type ProductItem } from '../../server/products.ts';
import { uploadUrl } from '../../server/uploads.ts';
import { pluralRu } from '../../server/util.ts';

interface Props {
  items: CategoryNode[];
  products: ProductItem[];
}
const { items, products } = Astro.props;
const tiles = items.map((c) => {
  const list = productsOf(products, c);
  const img = list.find((p) => p.images.length)?.images[0];
  return { c, img, count: list.length, stock: list.filter((p) => p.inStock).length };
});
---

<div class="ss-tiles">
  {
    tiles.map(({ c, img, count, stock }) => (
      <a class="ss-tile" href={`/${c.slug}`}>
        <span class="ss-tile-img">
          {img ? <img src={uploadUrl(productThumb(img))} alt="" width="600" height="450" loading="lazy" /> : <span class="pcard2-noimg" />}
        </span>
        <span class="ss-tile-body">
          <span class="ss-tile-name">{c.name}</span>
          {c.description && <span class="ss-tile-text">{c.description}</span>}
          <span class="ss-tile-count">
            {`${count} ${pluralRu(count, ['товар', 'товара', 'товаров'])}${stock > 0 ? `, в наличии ${stock}` : ''}`}
          </span>
        </span>
      </a>
    ))
  }
</div>
