---
// Главная сайта раздела в виде «группы и категории» (как сайт Forbo Eurocol): заголовок, плитки групп продукции,
// товары в наличии, текст о продукции, связь. Группы и категории — src/server/products.ts (getCategoryTree).
import CategoryTiles from './CategoryTiles.astro';
import ProductCard from './ProductCard.astro';
import type { CategoryNode, ProductItem } from '../../server/products.ts';
import type { Section } from '../../server/sections.ts';
import type { Settings } from '../../server/settings.ts';
import { homeSrcset, uploadUrl } from '../../server/uploads.ts';

interface Props {
  site: Section;
  products: ProductItem[];
  tree: CategoryNode[];
  settings: Settings;
}
const { site, products, tree, settings } = Astro.props;
const heading = site.heading || site.name;
const phoneHref = 'tel:' + settings.phone_main.replace(/[^\d+]/g, '');
const waHref = 'https://wa.me/' + settings.panel_whatsapp.replace(/\D/g, '');
const inStock = products.filter((p) => p.inStock);
const heroImg = site.image ? uploadUrl(site.image) : '';
---

<section class:list={['pcat-hero ss-hero', { 'pcat-hero--noimg': !heroImg }]}>
  {heroImg && <img class="pcat-hero-img" src={heroImg} srcset={homeSrcset(site.image)} sizes="100vw" alt="" width="1600" height="1067" fetchpriority="high" />}
  <div class="pcat-hero-card">
    <h1 class="pcat-title">{heading}</h1>
    {site.summary && <p class="pcat-text">{site.summary}</p>}
    <div class="psection-links">
      {tree.length > 0 && <a class="pbtn" href="#products">Продукция</a>}
      {inStock.length > 0 && <a class="pbtn pbtn-outline" href="#in-stock">В наличии</a>}
    </div>
  </div>
</section>

<section class="psec" id="products">
  <div class="pin">
    <h2 class="ptitle">Продукция</h2>
    {
      tree.length > 0 ? (
        <Fragment>
          <p class="psub">Выберите группу продуктов.</p>
          <CategoryTiles items={tree} products={products} />
        </Fragment>
      ) : (
        <p class="psub">Каталог пополняется. Позвоните или напишите в WhatsApp: подберём материалы и сообщим наличие.</p>
      )
    }
  </div>
</section>

{
  inStock.length > 0 && (
    <section class="psec ss-stock" id="in-stock">
      <div class="pin">
        <h2 class="ptitle">В наличии</h2>
        <p class="psub">Эти товары есть у нас сейчас. Остальные уточняйте по телефону или в WhatsApp.</p>
        <div class="pgrid ss-grid ss-grid--4">{inStock.map((p) => <ProductCard product={p} />)}</div>
      </div>
    </section>
  )
}

{
  site.description && (
    <section class="psec psalon ss-about" id="about">
      <div class="pin">
        <h2 class="ptitle">О продукции</h2>
        <div class="psalon-text" set:html={site.description} />
      </div>
    </section>
  )
}

<section class="psec pcontact" id="contacts">
  <div class="pin pcontact-grid">
    <div>
      <h2 class="ptitle">Подберём материалы</h2>
      <p class="psub">Позвоните или напишите: подскажем клей, грунтовку или ровнитель под ваше покрытие и основание, рассчитаем расход. Цену и наличие сообщим там же.</p>
    </div>
    <div class="pcontact-list">
      <a class="pcontact-phone" href={phoneHref}>{settings.phone_main}</a>
      {settings.panel_whatsapp && <a href={waHref} target="_blank" rel="noopener">WhatsApp {settings.panel_whatsapp}</a>}
      <span>{settings.address}</span>
      {settings.work_hours && <span>{settings.work_hours}</span>}
      {settings.email && <a href={`mailto:${settings.email}`}>{settings.email}</a>}
    </div>
  </div>
</section>
