---
// Страница товара на сайте раздела: фото (крупно по нажатию), характеристики, связь через WhatsApp и телефон,
// расчёт упаковок по площади, описание, таблица характеристик, похожие товары.
import Crumbs from '../Crumbs.astro';
import ProductCard from './ProductCard.astro';
import { packArea, productThumb, type ProductItem } from '../../server/products.ts';
import type { Settings } from '../../server/settings.ts';
import { uploadUrl } from '../../server/uploads.ts';

interface Props {
  product: ProductItem;
  related: ProductItem[];
  settings: Settings;
  /** Крошки до товара: по умолчанию «Каталог» → /#catalog; на сайте с категориями — группа и категория */
  crumbs?: { name: string; url: string }[];
  /** Строка про образцы в офисе (у строительной химии её нет) */
  samples?: boolean;
}
const { product: p, related, settings, crumbs = [{ name: 'Каталог', url: '/#catalog' }], samples = true } = Astro.props;
const sub = [p.brand, p.collection].filter(Boolean).join(' · ');
const phoneHref = 'tel:' + settings.phone_main.replace(/[^\d+]/g, '');
const waNumber = settings.panel_whatsapp.replace(/\D/g, '');
const waText = `Здравствуйте! Интересует ${[p.brand, p.collection, p.name].filter(Boolean).join(' ')}${p.sku ? `, артикул ${p.sku}` : ''}.`;
const waHref = `https://wa.me/${waNumber}?text=${encodeURIComponent(waText)}`;
const area = packArea(p);
// Подпись фото для Google Картинок: бренд, коллекция и название, как ищут покупатели
const alt = [p.brand, p.collection, p.name].filter(Boolean).join(' ');
---

<div class="pin ss-product">
  <Crumbs items={[...crumbs, { name: p.name }]} />

  <div class="ss-product-grid">
    <div class="ss-gallery">
      {
        p.images.length > 0 ? (
          <Fragment>
            <a class="ss-gallery-main" href={uploadUrl(p.images[0])} data-lightbox>
              <img src={uploadUrl(p.images[0])} alt={alt} width="1600" height="1200" fetchpriority="high" />
            </a>
            {p.images.slice(1).map((img) => (
              <a class="ss-gallery-thumb" href={uploadUrl(img)} data-lightbox>
                <img src={uploadUrl(productThumb(img))} alt={`${alt}: в интерьере`} width="600" height="400" loading="lazy" />
              </a>
            ))}
          </Fragment>
        ) : (
          <span class="ss-gallery-main pcard2-noimg" />
        )
      }
    </div>

    <div class="ss-product-info">
      {p.inStock && <span class="ss-badge ss-badge--inline ss-badge--stock">В наличии</span>}
      {p.isNew && <span class="ss-badge ss-badge--inline">Новинка</span>}
      {sub && <div class="pcard2-sub">{sub}</div>}
      <h1 class="pcat-title">{p.name}</h1>
      {p.sku && <div class="ss-sku">Артикул {p.sku}</div>}
      {
        p.attributes.length > 0 && (
          <dl class="ss-attrs">
            {p.attributes.map((a) => (
              <div><dt>{a.label}</dt><dd>{a.value}</dd></div>
            ))}
          </dl>
        )
      }
      <div class="psection-links ss-actions">
        {waNumber && <a class="pbtn" href={waHref} target="_blank" rel="noopener" data-wa data-wa-text={waText} data-wa-number={waNumber}>Написать в WhatsApp</a>}
        <a class="pbtn pbtn-outline" href={phoneHref}>{settings.phone_main}</a>
      </div>
      <p class="ss-note">
        {p.inStock ? 'Товар есть в наличии. Цену сообщим по телефону или в WhatsApp.' : 'Цену и наличие сообщим по телефону или в WhatsApp.'}
        {samples && ` Образцы можно посмотреть в офисе: ${settings.address}.`}
      </p>

      {
        area && (
          <div class="ss-calc" data-calc data-pack={area}>
            <label for="calc-area">Площадь пола, м²</label>
            <input type="number" id="calc-area" min="0" step="0.1" inputmode="decimal" placeholder="например 18" />
            <output data-calc-out>В упаковке {area.toLocaleString('ru-RU')} м². Укажите площадь, и мы посчитаем упаковки с запасом 5% на подрезку.</output>
          </div>
        )
      }
    </div>
  </div>

  {p.description && <div class="ppage-text ss-desc" set:html={p.description} />}

  {
    p.specs.length > 0 && (
      <section class="ss-specs">
        <h2 class="ptitle">Характеристики</h2>
        <table>
          <tbody>{p.specs.map((s) => <tr><th>{s.label}</th><td>{s.value}</td></tr>)}</tbody>
        </table>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="ss-related">
        <h2 class="ptitle">{crumbs.length > 1 ? `Ещё в категории «${crumbs[crumbs.length - 1].name}»` : 'Похожие'}</h2>
        <div class="pgrid ss-grid ss-grid--4">{related.map((r) => <ProductCard product={r} />)}</div>
      </section>
    )
  }
</div>
