---
// Страница группы или категории на сайте с категориями (как у Forbo Eurocol): слева все группы, справа
// категории группы плитками или товары категории (сначала «В наличии»).
import Crumbs from '../Crumbs.astro';
import CategoryTiles from './CategoryTiles.astro';
import ProductCard from './ProductCard.astro';
import { productsOf, type CategoryNode, type ProductItem } from '../../server/products.ts';
import { pluralRu } from '../../server/util.ts';

interface Props {
  tree: CategoryNode[];
  /** Группа; для категории — её группа */
  group: CategoryNode;
  /** Категория внутри группы; пусто — открыта сама группа */
  category?: CategoryNode;
  products: ProductItem[];
}
const { tree, group, category, products } = Astro.props;
const current = category ?? group;
const items = current.children.length ? [] : productsOf(products, current);
const stock = items.filter((p) => p.inStock).length;
const crumbs = [{ name: 'Продукция', url: '/#products' }, ...(category ? [{ name: group.name, url: `/${group.slug}` }] : []), { name: current.name }];
---

<div class="pin ss-cat">
  <Crumbs items={crumbs} />

  <div class="ss-cat-grid">
    <nav class="ss-cat-nav" aria-label="Группы продукции">
      <div class="ss-cat-nav-title">Продукция</div>
      <ul>
        {
          tree.map((g) => (
            <li class:list={{ 'is-open': g.id === group.id }}>
              <a href={`/${g.slug}`} aria-current={g.id === current.id ? 'page' : undefined}>{g.name}</a>
              {g.id === group.id && g.children.length > 0 && (
                <ul>
                  {g.children.map((c) => (
                    <li><a href={`/${c.slug}`} aria-current={c.id === current.id ? 'page' : undefined}>{c.name}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h1 class="pcat-title ss-cat-title">{current.name}</h1>
      {current.description && <p class="psub ss-cat-lead">{current.description}</p>}
      {
        current.children.length > 0 ? (
          <Fragment>
            <h2 class="ss-cat-sub">Выберите категорию</h2>
            <CategoryTiles items={current.children} products={products} />
          </Fragment>
        ) : (
          <Fragment>
            <p class="ss-count">
              {items.length} {pluralRu(items.length, ['товар', 'товара', 'товаров'])}{stock > 0 && `, в наличии ${stock}`}
            </p>
            <div class="pgrid ss-grid">{items.map((p) => <ProductCard product={p} />)}</div>
          </Fragment>
        )
      }
    </div>
  </div>
</div>
