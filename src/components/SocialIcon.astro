---
// Фирменные значки соцсетей (глиф Instagram и «f» Facebook). Цвет берут из текста ссылки.
interface Props {
  name: 'instagram' | 'facebook';
  size?: number;
}
const { name, size = 16 } = Astro.props;
---

{
  name === 'instagram' ? (
    <svg class="social-ico" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
      <circle cx="12" cy="12" r="4.3" />
      <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
    </svg>
  ) : (
    <svg class="social-ico" width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M13.5 21.9v-7.4H16l.4-3h-2.9V9.6c0-.9.3-1.5 1.5-1.5h1.6V5.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5v7.4a10 10 0 1 1 3 0z" />
    </svg>
  )
}
