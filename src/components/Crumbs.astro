---
// Хлебные крошки: ⌂ › Винил
interface Props {
  items: { name: string; url?: string }[];
}
const { items } = Astro.props;
---

<nav class="pcrumbs" aria-label="Вы здесь">
  <a href="/" aria-label="Главная">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 11l9-8 9 8v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z" /></svg>
  </a>
  {
    items.map((it, i) => (
      <Fragment>
        <span class="pcrumbs-sep" aria-hidden="true">›</span>
        {it.url && i < items.length - 1 ? <a href={it.url}>{it.name}</a> : <span aria-current="page">{it.name}</span>}
      </Fragment>
    ))
  }
</nav>
