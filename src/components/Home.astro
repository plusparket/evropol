---
// Главная в духе europroject.kg: большой слайдер фото, под ним плитки разделов, затем контакты и новости
// в две колонки, карточки разделов (каждый ведёт на свой сайт), производители и текст о компании.
// Тексты редактируются в админке: «Главная страница» (src/server/home.ts), карточки — «Разделы», логотипы — «Бренды».
import Lines from './Lines.astro';
import type { HomeContent } from '../server/home.ts';
import type { News } from '../server/content.ts';
import { isExternal, linkLabel, sectionUrl, type Brand, type Section } from '../server/sections.ts';
import type { Settings } from '../server/settings.ts';
import { homeSrcset, uploadUrl } from '../server/uploads.ts';
import { formatDate, plainText } from '../server/util.ts';

interface Props {
  home: HomeContent;
  /** HTML текста о компании с уже подставленными контактами */
  aboutHtml: string;
  sections: Section[];
  brands: Brand[];
  news: News[];
  settings: Settings;
}
const { home, aboutHtml, sections, brands, news, settings } = Astro.props;
const heroImages = home.hero.images.filter(Boolean);
const phoneHref = 'tel:' + settings.phone_main.replace(/[^\d+]/g, '');
const waHref = 'https://wa.me/' + settings.panel_whatsapp.replace(/\D/g, '');
// Логотип ведёт на страницу раздела бренда (там описание и ссылка на коллекции), без раздела — по ссылке бренда
const brandHref = (b: Brand) => {
  const s = sections.find((x) => x.id === b.sectionId);
  return s ? sectionUrl(s) : b.link;
};
const cover = (n: News) => (n.image ? uploadUrl(n.image) : (n.content.match(/<img[^>]+src="([^"]+)"/)?.[1] ?? ''));
---

<section class:list={['phero', { 'phero--noimg': heroImages.length === 0 }]} data-hero aria-label="Главный экран">
  {
    heroImages.map((img, i) => (
      <div class:list={['phero-slide', { active: i === 0 }]}>
        {i === 0 ? (
          <img src={uploadUrl(img)} srcset={homeSrcset(img)} sizes="100vw" alt="" width="2560" height="1440" fetchpriority="high" />
        ) : (
          <img data-src={uploadUrl(img)} data-srcset={homeSrcset(img)} sizes="100vw" alt="" width="2560" height="1440" />
        )}
      </div>
    ))
  }
  {
    home.hero.title ? (
      <div class="phero-caption">
        <h1 class="phero-title"><Lines text={home.hero.title} /></h1>
        {home.hero.text && <p class="phero-text">{home.hero.text}</p>}
        {home.hero.button && <a class="pbtn" href={home.hero.link}>{home.hero.button}</a>}
      </div>
    ) : (
      <h1 class="sr-only">{settings.seo_title || settings.site_name}</h1>
    )
  }
  {
    heroImages.length > 1 && (
      <Fragment>
        <button type="button" class="phero-arrow phero-arrow--prev" data-hero-prev aria-label="Предыдущее фото">
          <svg width="22" height="40" viewBox="0 0 22 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 2 2 20l18 18" /></svg>
        </button>
        <div class="phero-controls">
          <button type="button" class="phero-pause" data-hero-pause aria-label="Пауза">
            <svg class="i-pause" width="14" height="16" viewBox="0 0 14 16" fill="currentColor" aria-hidden="true"><path d="M1 0h4v16H1zM9 0h4v16H9z" /></svg>
            <svg class="i-play" width="14" height="16" viewBox="0 0 14 16" fill="currentColor" aria-hidden="true"><path d="M1 0l13 8-13 8z" /></svg>
          </button>
          <button type="button" class="phero-arrow phero-arrow--next" data-hero-next aria-label="Следующее фото">
            <svg width="22" height="40" viewBox="0 0 22 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m2 2 18 18L2 38" /></svg>
          </button>
        </div>
      </Fragment>
    )
  }
</section>

{
  sections.length > 0 && (
    <nav class="ptiles" aria-label="Разделы">
      {sections.map((s) => <a href={sectionUrl(s)}>{s.name}</a>)}
    </nav>
  )
}

{
  (home.contact.title || (home.news.title && news.length > 0)) && (
    <section class="psec pinfo">
      <div class="pin pinfo-grid">
        {home.contact.title && (
          <div class="pinfo-contacts">
            <h2 class="ptitle">{home.contact.title}</h2>
            {home.contact.text && <p class="pinfo-lead">{home.contact.text}</p>}
            <ul class="pinfo-list">
              <li>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 21s-7-6.3-7-11.5a7 7 0 0 1 14 0C19 14.7 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
                <span>{settings.address}</span>
              </li>
              <li>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" /></svg>
                <span>Тел.: <a href={phoneHref}>{settings.phone_main}</a></span>
              </li>
              {settings.panel_whatsapp && (
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5.1 5.2-1.4A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3.1.8.8-3-.2-.3a8.2 8.2 0 1 1 7 3.9Z" /></svg>
                  <span>WhatsApp: <a href={waHref} target="_blank" rel="noopener">{settings.panel_whatsapp}</a></span>
                </li>
              )}
              {settings.email && (
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="1.5" /><path d="m3 6 9 7 9-7" /></svg>
                  <a href={`mailto:${settings.email}`}>{settings.email}</a>
                </li>
              )}
              {settings.work_hours && (
                <li>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9.5" /><path d="M12 6.5V12l3.5 2" /></svg>
                  <span>{settings.work_hours}</span>
                </li>
              )}
            </ul>
            <a class="pbtn" href="/contact">Связаться</a>
          </div>
        )}
        {home.news.title && news.length > 0 && (
          <div class="pinfo-news">
            <h2 class="ptitle">{home.news.title}</h2>
            <div class="pnews-list">
              {news.map((n) => (
                <a class="pnews-item" href={`/news/${n.slug}`}>
                  <span class="pnews-img">{cover(n) && <img src={cover(n)} alt="" loading="lazy" />}</span>
                  <span class="pnews-body">
                    <span class="pnews-date">{formatDate(n.publishedAt)}</span>
                    <span class="pnews-title">{n.title}</span>
                    {(n.excerpt || n.content) && <span class="pnews-excerpt">{plainText(n.excerpt || n.content, 120)}</span>}
                    <span class="pnews-more">Подробнее</span>
                  </span>
                </a>
              ))}
            </div>
            <a class="plink" href="/news">Все новости</a>
          </div>
        )}
      </div>
    </section>
  )
}

{
  home.sections.title && sections.length > 0 && (
    <section class="psec psections" id="razdely">
      <div class="pin">
        <h2 class="ptitle">{home.sections.title}</h2>
        {home.sections.text && <p class="psub">{home.sections.text}</p>}
        <div class="psections-grid">
          {sections.map((s) => (
            <article class="psection">
              <a class="psection-img" href={sectionUrl(s)} tabindex="-1" aria-hidden="true">
                {s.image ? (
                  <img src={uploadUrl(s.image)} srcset={homeSrcset(s.image)} sizes="(max-width: 768px) 96vw, 380px" alt="" width="760" height="500" loading="lazy" />
                ) : (
                  <span class="psection-noimg" />
                )}
              </a>
              <div class="psection-body">
                <h3 class="psection-title"><a href={sectionUrl(s)}>{s.name}</a></h3>
                {s.summary && <p class="psection-text">{s.summary}</p>}
                <div class="psection-links">
                  {s.link && (
                    <a class="pbtn" href={s.link} target={isExternal(s.link) ? '_blank' : undefined} rel={isExternal(s.link) ? 'noopener' : undefined}>
                      {linkLabel(s)}
                    </a>
                  )}
                  <a class="plink" href={sectionUrl(s)}>Подробнее</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  home.brands.title && brands.length > 0 && (
    <section class="psec pbrands">
      <div class="pin">
        <h2 class="ptitle">{home.brands.title}</h2>
        {home.brands.text && <p class="psub">{home.brands.text}</p>}
        <div class="pbrands-grid">
          {brands.map((b) => (
            <a class="pbrand" href={brandHref(b) || undefined} title={b.name}
              target={isExternal(brandHref(b)) ? '_blank' : undefined} rel={isExternal(brandHref(b)) ? 'noopener' : undefined}>
              {b.logo ? <img src={uploadUrl(b.logo)} alt={b.name} loading="lazy" /> : <span>{b.name}</span>}
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  home.about.title && (
    <section class="psec psalon">
      <div class="pin">
        <h2 class="ptitle">{home.about.title}</h2>
        <div class="psalon-text" set:html={aboutHtml} />
        {home.about.linkText && <a class="plink" href={home.about.link}>{home.about.linkText}</a>}
      </div>
    </section>
  )
}
