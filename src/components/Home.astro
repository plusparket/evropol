---
// Главная по образцу berryalloc.com/en (владелец, 10.11.2026): слайдер фото во всю ширину, приветствие, плитки
// разделов «Поиск по продуктам» (фото в интерьере, название, короткое описание, кнопка), блок консультации с кнопкой
// WhatsApp. Подвал (Footer.astro) прежний. Тексты редактируются в админке: «Главная страница» (src/server/home.ts),
// фото плиток — public/img/home/<slug раздела>.webp (для нового раздела берётся фото из «Разделов»).
import Lines from './Lines.astro';
import { HOME_BANNER, HOME_TILE_IMAGES, type HomeContent } from '../server/home.ts';
import { isExternal, sectionHref, type Section } from '../server/sections.ts';
import type { Settings } from '../server/settings.ts';
import { homeSrcset, uploadUrl } from '../server/uploads.ts';

interface Props {
  home: HomeContent;
  sections: Section[];
  settings: Settings;
}
const { home, sections, settings } = Astro.props;
// Баннер: фото разделов с подписью раздела (галочка в админке) или загруженные фото, как раньше
const bannerSections = home.hero.sectionSlides ? sections.filter((s) => HOME_BANNER[s.slug]) : [];
const bannerSrcset = (slug: string) =>
  [800, 1400].filter((w) => w < HOME_BANNER[slug]).map((w) => `/img/home/banner/${slug}-${w}.webp ${w}w`)
    .concat(`/img/home/banner/${slug}.webp ${HOME_BANNER[slug]}w`).join(', ');
type Slide = { src: string; srcset?: string; section?: Section };
const slides: Slide[] = bannerSections.length
  ? bannerSections.map((s) => ({ src: `/img/home/banner/${s.slug}.webp`, srcset: bannerSrcset(s.slug), section: s }))
  : home.hero.images.filter(Boolean).map((img) => ({ src: uploadUrl(img), srcset: homeSrcset(img) }));
const heroImages = slides;
const waNumber = settings.panel_whatsapp.replace(/\D/g, '');
const consultHref = home.consult.link || (waNumber ? `https://wa.me/${waNumber}` : '/contact');
const tileImg = (s: Section) => (HOME_TILE_IMAGES.includes(s.slug) ? `/img/home/${s.slug}.webp` : s.image ? uploadUrl(s.image) : '');
const tileSections = sections.filter((s) => !home.catalog.hidden.includes(s.slug));
const tileText = (s: Section) => home.catalog.texts[s.slug] || s.summary;
const ext = (href: string) => (isExternal(href) ? { target: '_blank', rel: 'noopener' } : {});
const WelcomeTag = home.hero.title && !bannerSections.length ? 'h2' : 'h1';
---

<section class:list={['phero', { 'phero--noimg': heroImages.length === 0, 'phero--sections': bannerSections.length > 0 }]} data-hero aria-label="Главный экран">
  {
    slides.map((sl, i) => (
      <div class:list={['phero-slide', { active: i === 0 }]}>
        {i === 0 ? (
          <img src={sl.src} srcset={sl.srcset} sizes="100vw" alt={sl.section ? `${sl.section.name} в интерьере` : ''} width="1920" height="1080" fetchpriority="high" />
        ) : (
          <img data-src={sl.src} data-srcset={sl.srcset} sizes="100vw" alt={sl.section ? `${sl.section.name} в интерьере` : ''} width="1920" height="1080" />
        )}
        {sl.section && (
          <a class="phero-label" href={sectionHref(sl.section)} {...ext(sectionHref(sl.section))}>
            <span class="phero-label-name">{sl.section.name}</span>
            {home.catalog.button && <span class="phero-label-more">{home.catalog.button} →</span>}
          </a>
        )}
      </div>
    ))
  }
  {
    home.hero.title && !bannerSections.length ? (
      <div class="phero-caption">
        <h1 class="phero-title"><Lines text={home.hero.title} /></h1>
        {home.hero.text && <p class="phero-text">{home.hero.text}</p>}
        {home.hero.button && <a class="pbtn" href={home.hero.link}>{home.hero.button}</a>}
      </div>
    ) : (
      !home.welcome.title && <h1 class="sr-only">{settings.seo_title || settings.site_name}</h1>
    )
  }
  {
    heroImages.length > 1 && (
      <Fragment>
        <button type="button" class="phero-arrow phero-arrow--prev" data-hero-prev aria-label="Предыдущее фото">
          <svg width="22" height="40" viewBox="0 0 22 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 2 2 20l18 18" /></svg>
        </button>
        <div class="phero-controls">
          <button type="button" class="phero-pause" data-hero-pause aria-label="Пауза">
            <svg class="i-pause" width="14" height="16" viewBox="0 0 14 16" fill="currentColor" aria-hidden="true"><path d="M1 0h4v16H1zM9 0h4v16H9z" /></svg>
            <svg class="i-play" width="14" height="16" viewBox="0 0 14 16" fill="currentColor" aria-hidden="true"><path d="M1 0l13 8-13 8z" /></svg>
          </button>
          <button type="button" class="phero-arrow phero-arrow--next" data-hero-next aria-label="Следующее фото">
            <svg width="22" height="40" viewBox="0 0 22 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m2 2 18 18L2 38" /></svg>
          </button>
        </div>
      </Fragment>
    )
  }
</section>

{
  (home.welcome.title || home.welcome.text) && (
    <section class="bw">
      <div class="bw-in">
        {home.welcome.title && <WelcomeTag class="bw-title">{home.welcome.title}</WelcomeTag>}
        {home.welcome.text && <p>{home.welcome.text}</p>}
      </div>
    </section>
  )
}

{
  tileSections.length > 0 && (
    <section class="bt" id="razdely" aria-label="Разделы">
      <div class="pin">
        {home.catalog.title && <h2 class="bt-head">{home.catalog.title}</h2>}
        <div class="bt-grid">
          {tileSections.map((s) => (
            <article class="bt-card">
              <a class="bt-img" href={sectionHref(s)} tabindex="-1" aria-hidden="true" {...ext(sectionHref(s))}>
                {tileImg(s) ? <img src={tileImg(s)} alt={`${s.name} в интерьере`} width="900" height="514" loading="lazy" /> : <span />}
              </a>
              <div class="bt-body">
                <h3 class="bt-title"><a href={sectionHref(s)} {...ext(sectionHref(s))}>{s.name}</a></h3>
                {tileText(s) && <p>{tileText(s)}</p>}
                {home.catalog.button && <a class="bt-btn" href={sectionHref(s)} {...ext(sectionHref(s))}>{home.catalog.button}</a>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  home.consult.title && (
    <section class="bc">
      <div class="pin">
        <h2 class="bc-title">{home.consult.title}</h2>
        {home.consult.text && <p><Lines text={home.consult.text} /></p>}
        {home.consult.button && <a class="bc-btn" href={consultHref} {...ext(consultHref)}>{home.consult.button}</a>}
      </div>
    </section>
  )
}
