---
// Страница «Укладка и уход» с вёрсткой как у страниц производителя (текст страницы начинается с <div class="gd">):
// крошки, крупный заголовок на белом фоне, широкая колонка. Блоки внутри текста описаны в site.css (раздел «gd»).
// Вёрстка «по шагам» (<div class="gs">, раздел «gs» в site.css) несёт заголовок h1 в самом тексте: ownTitle.
import Crumbs from './Crumbs.astro';

interface Props {
  title: string;
  html: string;
  parents?: { name: string; url: string }[];
  /** Заголовок h1 уже есть в тексте страницы */
  ownTitle?: boolean;
}
const { title, html, parents = [], ownTitle = false } = Astro.props;
---

<article class="gd-page">
  <div class="gd-wrap">
    <Crumbs items={[...parents, { name: title }]} />
    {!ownTitle && <h1 class="gd-title">{title}</h1>}
    <div set:html={html} />
  </div>
</article>
