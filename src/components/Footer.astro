---
// Подвал как на europroject.kg: чёрный, четыре колонки с заголовками и ссылками с точками, внизу копирайт.
// На главной справа от контактов — небольшая Google-карта с точкой ЕвроПол (на «Контактах» карта справа от текста).
import type { MenuName, MenuItem } from '../server/content.ts';
import { sectionHref, type Section } from '../server/sections.ts';
import type { OfficeMap, Settings } from '../server/settings.ts';
import SocialIcon from './SocialIcon.astro';

interface Props {
  settings: Settings;
  menus: Record<MenuName, MenuItem[]>;
  sections: Section[];
  copyright: string;
  /** Карта офиса (только на главной) */
  map?: OfficeMap;
}
const { settings, menus, sections, copyright, map } = Astro.props;
const phoneHref = (p: string) => 'tel:' + p.replace(/[^\d+]/g, '');
---

<footer class="pf">
  <div class:list={['pf-cols', { 'pf-cols--map': map }]}>
    <div class="pf-col">
      <div class="pf-title">О компании</div>
      <ul>{menus.footer_company.map((m) => <li><a href={m.url} target={m.newTab ? '_blank' : undefined}>{m.label}</a></li>)}</ul>
    </div>
    {
      sections.length > 0 && (
        <div class="pf-col">
          <div class="pf-title">Продукты</div>
          <ul>{sections.map((s) => <li><a href={sectionHref(s)}>{s.name}</a></li>)}</ul>
        </div>
      )
    }
    <div class="pf-col">
      <div class="pf-title">Контакты</div>
      <ul>
        <li>Магазин «{settings.site_name}»:<br />{settings.address}</li>
        <li>Телефон: <a href={phoneHref(settings.phone_main)}>{settings.phone_main}</a></li>
        {settings.work_hours && <li>Режим работы: {settings.work_hours}</li>}
        {settings.address_second && <li>{settings.name_second}, {settings.address_second}</li>}
        {settings.phone_second && <li><a href={phoneHref(settings.phone_second)}>{settings.phone_second}</a></li>}
        {settings.email && <li><a href={`mailto:${settings.email}`}>{settings.email}</a></li>}
      </ul>
    </div>
    {
      map && (
        <figure class="pf-map">
          <iframe data-src={map.src} title={`Карта: ${map.name}, ${map.address}`} allowfullscreen referrerpolicy="strict-origin-when-cross-origin" />
          <figcaption><a href={map.link} target="_blank" rel="noopener">Открыть в Google Картах</a></figcaption>
        </figure>
      )
    }
    <div class="pf-col">
      <div class="pf-title">Соц. сети</div>
      <p class="pf-note">Связаться с нами:</p>
      <div class="pf-social">
        {settings.instagram_url && <a href={settings.instagram_url} target="_blank" rel="noopener" aria-label="Instagram"><SocialIcon name="instagram" size={22} /></a>}
        {settings.facebook_url && <a href={settings.facebook_url} target="_blank" rel="noopener" aria-label="Facebook"><SocialIcon name="facebook" size={22} /></a>}
      </div>
    </div>
  </div>

  <div class="pf-bottom">{copyright}</div>
</footer>
