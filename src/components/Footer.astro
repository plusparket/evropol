---
// Подвал как на europroject.kg: чёрный, четыре колонки с заголовками и ссылками с точками, внизу копирайт.
// На главной справа от контактов — Google-карта с точкой ЕвроПол (на «Контактах» карта справа от текста).
import type { MenuName, MenuItem } from '../server/content.ts';
import { sectionHref, type Section } from '../server/sections.ts';
import type { OfficeMap, Settings } from '../server/settings.ts';
import FooterSocial from './FooterSocial.astro';
import SocialIcon from './SocialIcon.astro';

interface Props {
  settings: Settings;
  menus: Record<MenuName, MenuItem[]>;
  sections: Section[];
  copyright: string;
  /** Карта офиса (только на главной) */
  map?: OfficeMap;
  /** Подвал по образцу mohawkflooring.com (каталоги из настройки «mohawk_catalogs»): «Укладка и уход» раздела */
  mh?: { guides: { label: string; url: string }[] };
}
const { settings, menus, sections, copyright, map, mh } = Astro.props;
const waNumber = settings.panel_whatsapp.replace(/\D/g, '');
const phoneHref = (p: string) => 'tel:' + p.replace(/[^\d+]/g, '');
// «Соц. сети»: своя колонка, а на главной (рядом карта) — под «Контактами», чтобы карте хватило места
---

{
  mh ? (
    <footer class="pf mhf">
      <div class="mhf-cols">
        <a class="mhf-logo" href="/" aria-label={settings.site_name}><img src="/img/evropol-logo.svg?v=5" alt="" width="528" height="100" /></a>
        {sections.length > 0 && (
          <div class="mhf-col">
            <div class="mhf-title">Каталог</div>
            <ul>{sections.map((s) => <li><a href={sectionHref(s)}>{s.name}</a></li>)}</ul>
          </div>
        )}
        <div class="mhf-col">
          <div class="mhf-title">О компании</div>
          <ul>{menus.footer_company.map((m) => <li><a href={m.url} target={m.newTab ? '_blank' : undefined}>{m.label}</a></li>)}</ul>
        </div>
        <div class="mhf-col">
          <div class="mhf-title">Покупателям</div>
          <ul>
            {mh.guides.map((g) => <li><a href={g.url}>{g.label}</a></li>)}
            <li>{settings.address}</li>
            <li><a href={phoneHref(settings.phone_main)}>{settings.phone_main}</a></li>
            {settings.work_hours && <li>Режим работы: {settings.work_hours}</li>}
            {settings.email && <li><a href={`mailto:${settings.email}`}>{settings.email}</a></li>}
          </ul>
        </div>
        {waNumber && (
          <form class="mhf-form" action={`https://wa.me/${waNumber}`} method="get" target="_blank" data-wa-form>
            <div class="mhf-title">Напишите нам в WhatsApp</div>
            <p class="mhf-lead">Укажите покрытие и площадь: подберём варианты и посчитаем количество.</p>
            <input type="text" name="name" placeholder="Ваше имя" aria-label="Ваше имя" autocomplete="given-name" />
            <input type="text" name="text" placeholder="Что ищете, площадь в м²" aria-label="Что ищете, площадь в м²" />
            <button type="submit">Написать в WhatsApp</button>
          </form>
        )}
      </div>
      <div class="mhf-bottom">
        <div class="mhf-social">
          {settings.instagram_url && <a href={settings.instagram_url} target="_blank" rel="noopener" aria-label="Instagram"><SocialIcon name="instagram" size={18} /></a>}
          {settings.facebook_url && <a href={settings.facebook_url} target="_blank" rel="noopener" aria-label="Facebook"><SocialIcon name="facebook" size={18} /></a>}
        </div>
        <span class="mhf-copy">{copyright}</span>
        <nav class="mhf-links" aria-label="Информация">
          {menus.footer_company.map((m) => <a href={m.url}>{m.label}</a>)}
        </nav>
      </div>
    </footer>
  ) : (
    <footer class="pf">
      <div class:list={['pf-cols', { 'pf-cols--map': map }]}>
        <div class="pf-col">
          <div class="pf-title">О компании</div>
          <ul>{menus.footer_company.map((m) => <li><a href={m.url} target={m.newTab ? '_blank' : undefined}>{m.label}</a></li>)}</ul>
        </div>
        {
          sections.length > 0 && (
            <div class="pf-col">
              <div class="pf-title">Продукты</div>
              <ul>{sections.map((s) => <li><a href={sectionHref(s)}>{s.name}</a></li>)}</ul>
            </div>
          )
        }
        <div class="pf-col">
          <div class="pf-title">Контакты</div>
          <ul>
            <li>Магазин «{settings.site_name}»:<br />{settings.address}</li>
            <li>Телефон: <a href={phoneHref(settings.phone_main)}>{settings.phone_main}</a></li>
            {settings.work_hours && <li>Режим работы: {settings.work_hours}</li>}
            {settings.address_second && <li>{settings.name_second}, {settings.address_second}</li>}
            {settings.phone_second && <li><a href={phoneHref(settings.phone_second)}>{settings.phone_second}</a></li>}
            {settings.email && <li><a href={`mailto:${settings.email}`}>{settings.email}</a></li>}
          </ul>
          {map && <div class="pf-under"><FooterSocial settings={settings} /></div>}
        </div>
        {
          map && (
            <figure class="pf-map">
              <iframe data-src={map.src} title={`Карта: ${map.name}, ${map.address}`} allowfullscreen referrerpolicy="strict-origin-when-cross-origin" />
              <figcaption><a href={map.link} target="_blank" rel="noopener">Открыть в Google Картах</a></figcaption>
            </figure>
          )
        }
        {
          !map && (
            <div class="pf-col">
              <FooterSocial settings={settings} />
            </div>
          )
        }
      </div>

      <div class="pf-bottom">{copyright}</div>
    </footer>
  )
}
