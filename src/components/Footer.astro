---
// Подвал: логотип, колонки «Компания», «Продукты», «Контакты», «Соцсети», строка копирайта и карта.
import type { MenuName, MenuItem } from '../server/content.ts';
import { sectionUrl, type Section } from '../server/sections.ts';
import type { Settings } from '../server/settings.ts';
import SocialIcon from './SocialIcon.astro';

interface Props {
  settings: Settings;
  menus: Record<MenuName, MenuItem[]>;
  sections: Section[];
  maps: { src: string; title: string }[];
  copyright: string;
}
const { settings, menus, sections, maps, copyright } = Astro.props;
const phoneHref = (p: string) => 'tel:' + p.replace(/[^\d+]/g, '');
const hasSocial = settings.instagram_url || settings.facebook_url;
---

<footer class="pf">
  <div class="pf-cols">
    <div class="pf-col pf-brand">
      <a href="/" aria-label={settings.site_name}><img src="/img/europroject-logo-white.svg" alt={settings.site_name} width="142" height="90" /></a>
    </div>
    <div class="pf-col">
      <div class="pf-title">Компания</div>
      {menus.footer_company.map((m) => <a href={m.url} target={m.newTab ? '_blank' : undefined}>{m.label}</a>)}
    </div>
    {
      sections.length > 0 && (
        <div class="pf-col">
          <div class="pf-title">Продукты</div>
          {sections.map((s) => <a href={sectionUrl(s)}>{s.name}</a>)}
        </div>
      )
    }
    <div class="pf-col">
      <div class="pf-title">Контакты</div>
      <div class="pf-contact">
        <span>{settings.address}</span>
        <a href={phoneHref(settings.phone_main)}>{settings.phone_main}</a>
        {settings.work_hours && <span>{settings.work_hours}</span>}
      </div>
      {
        (settings.phone_second || settings.address_second) && (
          <div class="pf-contact">
            <span>{settings.name_second}, {settings.address_second}</span>
            {settings.phone_second && <a href={phoneHref(settings.phone_second)}>{settings.phone_second}</a>}
            {settings.work_hours_second && <span>{settings.work_hours_second}</span>}
          </div>
        )
      }
      {settings.email && <a href={`mailto:${settings.email}`}>{settings.email}</a>}
    </div>
    {
      hasSocial && (
        <div class="pf-col">
          <div class="pf-title">Соцсети</div>
          <div class="pf-social">
            {settings.instagram_url && <a href={settings.instagram_url} target="_blank" rel="noopener" aria-label="Instagram"><SocialIcon name="instagram" size={20} /></a>}
            {settings.facebook_url && <a href={settings.facebook_url} target="_blank" rel="noopener" aria-label="Facebook"><SocialIcon name="facebook" size={20} /></a>}
          </div>
        </div>
      )
    }
  </div>

  <div class="pf-bottom">
    <span>{copyright}</span>
  </div>

  {
    maps.length > 0 && (
      <div class:list={['maps', { two: maps.length > 1 }]}>
        {maps.map((m) => (
          <div class="map">
            {maps.length > 1 && <div class="map_title">{m.title}</div>}
            <iframe data-src={m.src} title={`Карта: ${m.title}`} allowfullscreen referrerpolicy="strict-origin-when-cross-origin" />
          </div>
        ))}
      </div>
    )
  }
</footer>
