---
// Шапка главного сайта (владелец, 11.11.2026): верхняя строка «Главная, О нас, Новости и события, Контакты», справа
// Instagram и «Поиск по сайту» (/search); ниже логотип и все разделы продуктов в строку. На телефонах меню выдвигается сбоку.
import type { MenuItem, MenuName } from '../server/content.ts';
import { isExternal, sectionHref, sectionUrl, type Section } from '../server/sections.ts';
import type { Settings } from '../server/settings.ts';
import SocialIcon from './SocialIcon.astro';
import { GUIDES_LABEL } from '../server/section-guides.ts';

interface Props {
  sections: Section[];
  settings: Settings;
  menus: Record<MenuName, MenuItem[]>;
  /** Каталог раздела: «Укладка» и «Уход» (src/server/section-guides.ts) — встают вместо «Новости и события» */
  guides?: { label: string; url: string }[];
  /**
   * Шапка по образцу mohawkflooring.com (каталоги из настройки «mohawk_catalogs»): логотип, меню, поле поиска
   * по каталогу раздела, значки телефона и WhatsApp справа. search — адрес каталога, q — текущий запрос.
   */
  mh?: { search: string; q: string };
}
const { sections, settings, menus, guides = [], mh } = Astro.props;
const waHref = 'https://wa.me/' + settings.panel_whatsapp.replace(/\D/g, '');
const phoneHref = (p: string) => 'tel:' + p.replace(/[^\d+]/g, '');
// На странице каталога раздела адрес внутри приложения другой (/section-site/…): берём адрес раздела
const path = Astro.locals.site ? sectionUrl(Astro.locals.site) : Astro.url.pathname;
// Полный адрес внутри каталога (/linoleum/ukladka): по нему подсвечивается подраздел «Укладка и уход»
const site = Astro.locals.site;
const sub = site ? Astro.url.pathname.replace(/^\/section-site(?=\/|$)/, '').replace(new RegExp(`^${sectionUrl(site)}(?=/|$)`), '') : '';
const fullPath = site ? sectionUrl(site) + sub : path;
// В «Лесном» дизайне значок Instagram зелёный, под цвет логотипа
const forest = settings.forest_design === '1';
// Пункты меню: «Главная», затем верхнее меню из админки; «Продукты» (разделы) встают после «О компании»
type Link = { label: string; url: string; newTab?: boolean; products?: boolean; children?: { label: string; url: string }[] };
const links: Link[] = [];
const addLink = (l: Link) => links.some((x) => x.url === l.url) || links.push(l);
addLink({ label: 'Главная', url: '/' });
menus.top.forEach(addLink);
if (sections.length) {
  const about = links.findIndex((l) => l.url === '/about');
  links.splice(about >= 0 ? about + 1 : 1, 0, { label: 'Продукты', url: '/#razdely', products: true });
}
if (guides.length) {
  const guideLink: Link = { label: GUIDES_LABEL, url: guides[0].url, children: guides };
  const news = links.findIndex((l) => l.url === '/news');
  if (news >= 0) links.splice(news, 1, guideLink);
  else links.push(guideLink);
}
// Верхняя строка шапки: все пункты, кроме «Продукты»; «О компании» подписан «О нас» (владелец, 11.11.2026).
// Подразделы «Укладка и уход» — ссылкой на первый подраздел
const topLinks: Link[] = links
  .filter((l) => !l.products)
  .map((l) => (l.url === '/about' ? { ...l, label: 'О нас' } : l.children ? { ...l, url: l.children[0].url } : l));
const here = (l: Link) =>
  l.children ? l.children.some((c) => fullPath === c.url) : l.products ? sections.some((s) => path === sectionUrl(s)) : l.url === '/' ? path === '/' : path === l.url || path.startsWith(l.url + '/');
---

{
  mh ? (
    <header class="ph mhh" id="ph">
      <div class="mhh-in">
        <button type="button" class="ph-burger" id="burger" aria-controls="main-menu" aria-label="Меню"><i></i><i></i><i></i></button>
        <a href="/" class="mhh-logo" aria-label={settings.site_name}>
          <img src="/img/evropol-logo.svg?v=5" alt={settings.site_name} width="528" height="100" />
        </a>
        <nav class="ph-nav" aria-label="Меню">
          {
            links.map((l) =>
              l.products ? (
                <div class="ph-drop">
                  <button type="button" class:list={['ph-drop-btn', { active: here(l) }]} aria-haspopup="true" aria-expanded="false" data-drop>{l.label}</button>
                  <div class="ph-drop-list">
                    {sections.map((s) => <a href={sectionHref(s)} class:list={{ active: path === sectionUrl(s) }}>{s.name}</a>)}
                  </div>
                </div>
              ) : l.children ? (
                <div class="ph-drop">
                  <button type="button" class:list={['ph-drop-btn', { active: here(l) }]} aria-haspopup="true" aria-expanded="false" data-drop>{l.label}</button>
                  <div class="ph-drop-list">
                    {l.children.map((c) => <a href={c.url} class:list={{ active: fullPath === c.url }}>{c.label}</a>)}
                  </div>
                </div>
              ) : (
                <a href={l.url} class:list={{ active: here(l) }} target={l.newTab ? '_blank' : undefined}>{l.label}</a>
              ),
            )
          }
        </nav>
        <form class="mhh-search" action={mh.search} method="get" role="search">
          <input type="search" name="q" value={mh.q} placeholder="Поиск" aria-label="Поиск по каталогу" />
          <button type="submit" aria-label="Найти">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></svg>
          </button>
        </form>
        <a class="mhh-icon" href={phoneHref(settings.phone_main)} aria-label={`Позвонить: ${settings.phone_main}`}>
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11 11 0 0 0 5.2 5.2l1.4-2.1 4.2 1.6V17a2.5 2.5 0 0 1-2.7 2.5A15.5 15.5 0 0 1 2.5 6.2 2.5 2.5 0 0 1 5 3.5Z" /></svg>
        </a>
        {settings.panel_whatsapp && (
          <a class="mhh-icon" href={waHref} target="_blank" rel="noopener" aria-label={`WhatsApp ${settings.panel_whatsapp}`}>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 20.5l1.3-4.2a8.6 8.6 0 1 1 3.1 3l-4.4 1.2Z" /><path d="M9 8.6c.3 2.6 3.2 5.5 5.8 5.9l1.2-1.4-1.9-1-1 .8a5 5 0 0 1-2.4-2.4l.8-1-1-1.9Z" stroke-width="1.4" /></svg>
          </a>
        )}
      </div>
    </header>
  ) : (
    <header class="ph ph--two" id="ph">
    {/* Верхняя строка (владелец, 11.11.2026): Главная, О нас, Новости и события, Контакты, справа Instagram и поиск */}
    <div class="ph-top">
      <div class="ph-top-in">
        <nav class="ph-top-nav" aria-label="Разделы сайта">
          {topLinks.map((l) => (
            <a href={l.url} class:list={{ active: here(l) }} target={l.newTab ? '_blank' : undefined}>{l.label}</a>
          ))}
        </nav>
        <div class="ph-top-aside">
          {settings.instagram_url && <a class="ph-insta" href={settings.instagram_url} target="_blank" rel="noopener" aria-label="Instagram">{forest ? <SocialIcon name="instagram" size={20} /> : <img src="/img/instagram.png" alt="" width="32" height="32" />}</a>}
          <form class="ph-search" action="/search" method="get" role="search">
            <input type="search" name="q" placeholder="Поиск по сайту" aria-label="Поиск по сайту" />
            <button type="submit" aria-label="Найти">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></svg>
            </button>
          </form>
        </div>
      </div>
    </div>
    {/* Основная строка: логотип и все разделы продуктов */}
    <div class="ph-in">
      <a href="/" class="ph-logo" aria-label={settings.site_name}>
        <img src="/img/evropol-logo.svg?v=5" alt={settings.site_name} width="528" height="100" />
      </a>

      <nav class="ph-nav ph-nav--sections" aria-label="Продукты">
        {sections.map((s) => (
          <a href={sectionHref(s)} class:list={{ active: path === sectionUrl(s) }} target={isExternal(sectionHref(s)) ? '_blank' : undefined} rel={isExternal(sectionHref(s)) ? 'noopener' : undefined}>{s.name}</a>
        ))}
      </nav>

      <a class="ph-search-m" href="/search" aria-label="Поиск по сайту">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></svg>
      </a>
      <button type="button" class="ph-burger" id="burger" aria-controls="main-menu" aria-label="Меню"><i></i><i></i><i></i></button>
    </div>
    </header>
  )
}

<!-- Выдвижное меню на телефонах: пункты меню, разделы, контакты -->
<aside class="pdrawer" id="main-menu" aria-label="Меню">
  <div class="pdrawer-head">
    <img src="/img/evropol-logo.svg?v=5" alt="" class="pdrawer-logo" width="528" height="100" />
    <button type="button" class="pdrawer-close" data-menu-close aria-label="Закрыть меню">✕</button>
  </div>
  <form class="ph-search pdrawer-search" action="/search" method="get" role="search">
    <input type="search" name="q" placeholder="Поиск по сайту" aria-label="Поиск по сайту" />
    <button type="submit" aria-label="Найти">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></svg>
    </button>
  </form>
  <nav class="pdrawer-nav" aria-label="Меню">
    {
      links.map((l) =>
        l.products ? (
          <Fragment>
            <div class="pdrawer-label">{l.label}</div>
            {sections.map((s) => <a href={sectionHref(s)} class:list={['pdrawer-sub', { active: path === sectionUrl(s) }]}>{s.name}</a>)}
          </Fragment>
        ) : l.children ? (
          <Fragment>
            <div class="pdrawer-label">{l.label}</div>
            {l.children.map((c) => <a href={c.url} class:list={['pdrawer-sub', { active: fullPath === c.url }]}>{c.label}</a>)}
          </Fragment>
        ) : (
          <a href={l.url} class:list={{ active: here(l) }} target={l.newTab ? '_blank' : undefined}>{l.label}</a>
        ),
      )
    }
  </nav>
  <div class="pdrawer-contacts">
    <a href={phoneHref(settings.phone_main)}>{settings.phone_main}</a>
    <span>{settings.address}</span>
    {settings.email && <a href={`mailto:${settings.email}`}>{settings.email}</a>}
    {settings.phone_second && <a href={phoneHref(settings.phone_second)}>{settings.phone_second}</a>}
    {settings.address_second && <span>{settings.name_second}, {settings.address_second}</span>}
  </div>
</aside>
