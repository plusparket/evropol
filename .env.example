# Скопируйте в .env и поменяйте значения. Файл .env в git не попадает.

# Адрес сайта для Caddy.
#   локально:   SITE_ADDRESS=http://localhost
#   на сервере: SITE_ADDRESS=europroject.kg, www.europroject.kg   (HTTPS-сертификат выпустится автоматически)
SITE_ADDRESS=http://localhost

# Публичный адрес сайта (sitemap.xml, canonical-ссылки, разметка для Google).
# На сервере: SITE_URL=https://europroject.kg — без www: запросы на www.europroject.kg переадресуются сюда (301).
SITE_URL=http://localhost

# Postgres
POSTGRES_DB=europroject
POSTGRES_USER=europroject
POSTGRES_PASSWORD=change-me-strong-password

# Первый администратор (создаётся при первом запуске, если в базе ещё нет пользователей)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-admin-password

# Заполнить пустую базу контентом со старого сайта при первом запуске (true/false)
SEED_ON_START=true

# Часовой пояс (даты новостей, статистика посещений)
TZ=Asia/Bishkek

# Ключ доступа Instagram (long-lived access token) — посты из Instagram раз в две недели попадают в «Новости».
# Как получить — docs/news-instagram.md. Пусто — загрузка выключена.
INSTAGRAM_TOKEN=
