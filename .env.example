# Скопируйте в .env и поменяйте значения. Файл .env в git не попадает.

# Адрес сайта для Caddy.
#   локально:   SITE_ADDRESS=http://localhost

# Адреса сайтов разделов для Caddy (у каждого раздела свой сайт с каталогом, адрес задаётся в админке у раздела).
#   локально:   SECTION_SITES_ADDRESS=http://*.localhost   (vinyl.localhost и другие открываются в браузере сами)
#   на сервере: SECTION_SITES_ADDRESS=vinyl.evropol.kg, carpet.evropol.kg
SECTION_SITES_ADDRESS=http://*.localhost
#   на сервере: SITE_ADDRESS=evropol.kg, www.evropol.kg   (HTTPS-сертификат выпустится автоматически)
SITE_ADDRESS=http://localhost

# Адреса сайтов разделов для Caddy (у каждого раздела свой сайт с каталогом, адрес задаётся в админке у раздела).
#   локально:   SECTION_SITES_ADDRESS=http://*.localhost   (vinyl.localhost и другие открываются в браузере сами)
#   на сервере: SECTION_SITES_ADDRESS=vinyl.evropol.kg, carpet.evropol.kg
SECTION_SITES_ADDRESS=http://*.localhost

# Публичный адрес сайта (sitemap.xml, canonical-ссылки, разметка для Google).
# На сервере: SITE_URL=https://evropol.kg — без www: запросы на www.evropol.kg переадресуются сюда (301).
SITE_URL=http://localhost

# Старый домен: все его адреса переадресуются на SITE_URL (301), позиции в Google переходят на новый сайт.
#   на сервере: OLD_SITE_ADDRESS=europroject.kg, www.europroject.kg
# OLD_SITE_ADDRESS=

# Postgres
POSTGRES_DB=europroject
POSTGRES_USER=europroject
POSTGRES_PASSWORD=change-me-strong-password

# Первый администратор (создаётся при первом запуске, если в базе ещё нет пользователей)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-admin-password

# Заполнить пустую базу контентом со старого сайта при первом запуске (true/false)
SEED_ON_START=true

# Часовой пояс (даты новостей, статистика посещений)
TZ=Asia/Bishkek

# Ключ доступа Instagram (long-lived access token) — посты из Instagram раз в две недели попадают в «Новости».
# Как получить — docs/news-instagram.md. Пусто — загрузка выключена.
INSTAGRAM_TOKEN=
